#!/usr/bin/env python3
"""Convenience entry point: ./computor "equation"."""

import sys
from pathlib import Path

# Allow running as ./computor without setting PYTHONPATH
ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from computorv1.__main__ import main

if __name__ == "__main__":
    sys.exit(main())
